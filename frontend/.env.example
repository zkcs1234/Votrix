# VOTRIX frontend (Vercel)
# Set in Vercel → Project → Settings → Environment Variables

# Render API base URL (must include /api)
VITE_API_URL=https://your-api.onrender.com/api

# Feature flag — see PARTICIPANT_LOCK_FEATURE_FLAG.md
# Default/unset = production (participant roster locks once an event is active).
# Set to false ONLY for testing, to keep registering/inviting while active.
# Must match the backend LOCK_PARTICIPANTS_ON_ACTIVE. Rebuild after changing.
# VITE_LOCK_PARTICIPANTS_ON_ACTIVE=false
